# Railway Environment Variables for Grok Connector Server
# These are ONLY for the Railway-deployed grok-connector-server.js
# DO NOT commit this file - set variables in Railway dashboard instead

# X.AI Grok API Key (REQUIRED for Grok Connector)
XAI_API_KEY=xai_YOUR_KEY_HERE

# Port (Railway assigns this automatically, but this is the default)
PORT=3000

# Node Environment
NODE_ENV=production

# Optional: Logging level
LOG_LEVEL=info
