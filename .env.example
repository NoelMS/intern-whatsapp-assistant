# Environment Variables
# Copy this file to .env and fill in your actual values

# Twilio Credentials
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_AUTH_TOKEN=YOUR_WEBHOOK_AUTH_TOKEN

# AI Provider Keys

# Groq API (Primary Provider)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY

# X.AI Grok API (Secondary Provider)
# Get from: https://console.x.ai/team/default/api-keys
XAI_API_KEY=xai_YOUR_XAI_API_KEY

# Grok Connector Server URL (Tertiary Fallback)
# This is your Railway-deployed webhook server
# Format: https://your-railway-app.railway.app
GROK_CONNECTOR_URL=https://your-grok-connector.railway.app

# Node Environment
NODE_ENV=production
